# Express API host (server/.env)
# Keep API-only secrets here, not in frontend NEXT_PUBLIC_* variables.
NODE_ENV=development
API_PORT=5000
PORT=
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trackcoop
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA_PATH=
DB_CONNECTION_LIMIT=10

SESSION_COOKIE_NAME=trackcoop_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12

AUTH_MAX_FAILED_ATTEMPTS=15
AUTH_LOCKOUT_MINUTES=1
AUTH_LOGIN_RATE_LIMIT=100
AUTH_LOGIN_RATE_WINDOW_MINUTES=150
BCRYPT_ROUNDS=12

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=storage/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

PAYMONGO_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_ALLOW_LIVE_LOCAL=false
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_TEST_SECRET_KEY=
PAYMONGO_TEST_WEBHOOK_SECRET=
PAYMONGO_TEST_PAYMENT_METHOD_TYPES=qrph
PAYMONGO_LIVE_SECRET_KEY=
PAYMONGO_LIVE_WEBHOOK_SECRET=
PAYMONGO_LIVE_PAYMENT_METHOD_TYPES=qrph
PAYMONGO_SYSTEM_ACTOR_USER_ID=
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMONGO_CHECKOUT_REUSE_MINUTES=30
PAYMONGO_PASS_ON_FEES=false
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancelled

# Backend email delivery. EMAIL_DELIVERY is one of:
#   disabled  send nothing
#   resend    (recommended) queue emails in the database outbox and send them through the Resend HTTP API
#   smtp      LEGACY direct SMTP, kept temporarily as a fallback; to be removed in a later cleanup
#   webhook   LEGACY automation webhook
# See docs/email-notifications.md for the rollout stages and the cron worker.
EMAIL_DELIVERY=smtp
EMAIL_FROM_NAME=TrackCOOP
EMAIL_FROM_ADDRESS=davidgludo@gmail.com
# Reply-To for resend mode, e.g. support@nffac.trackcoop.online. Optional.
EMAIL_REPLY_TO=

# --- Resend (EMAIL_DELIVERY=resend) ---------------------------------------------------------------
# Resend mode sends from the verified notify subdomain, for example:
#   EMAIL_FROM_ADDRESS=notifications@notify.nffac.trackcoop.online
# RESEND_API_KEY: a "Sending access" key limited to the notify domain, from the Resend dashboard (starts with re_).
RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET: the signing secret of the Resend webhook (starts with whsec_). Needed by the API only,
# not by the cron worker. Webhook URL: <API_PUBLIC_URL>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# EMAIL_SECRET_KEY: 32 random bytes, base64. Encrypts activation links in the outbox and signs receipt links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes queued activation links unreadable and invalidates issued receipt links.
EMAIL_SECRET_KEY=
# Public https address of this API; receipt links in emails point here. No trailing slash.
API_PUBLIC_URL=
# restricted: send only to EMAIL_RECIPIENT_ALLOWLIST (everyone else is stored as Blocked and never sent).
# general:    send to every recipient. Switch only after the restricted stage has been verified.
EMAIL_RELEASE_STAGE=restricted
# Comma-separated test addresses allowed while EMAIL_RELEASE_STAGE=restricted.
EMAIL_RECIPIENT_ALLOWLIST=

# --- Legacy SMTP (EMAIL_DELIVERY=smtp) ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=davidgludo@gmail.com
SMTP_PASSWORD=

# --- Cron worker (separate process; see docs/email-notifications.md) -------------------------------
# Absolute path of a mode-600 file holding the worker's variables (DB_*, EMAIL_*, RESEND_API_KEY,
# EMAIL_SECRET_KEY, FRONTEND_URL, API_PUBLIC_URL). Set it in the cron command, never the secrets themselves.
# TRACKCOOP_WORKER_ENV_FILE=/home/ACCOUNT/trackcoop-worker.env

# Generic production example, provider-neutral:
# NODE_ENV=production
# FRONTEND_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SESSION_COOKIE_DOMAIN=.example.com
# SESSION_COOKIE_SAME_SITE=lax
# SESSION_COOKIE_SECURE=true
# TRUST_PROXY=true
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_LOGIN_RATE_WINDOW_MINUTES=15
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://object-storage.example.com
# S3_REGION=auto
# S3_BUCKET=trackcoop-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Local PayMongo QR Ph testing example:
# PAYMONGO_ENABLED=true
# PAYMONGO_MODE=test
# PAYMONGO_ALLOW_LIVE_LOCAL=false
# PAYMONGO_TEST_SECRET_KEY=sk_test_REPLACE_ME
# PAYMONGO_TEST_WEBHOOK_SECRET=REPLACE_TEST_WEBHOOK_SECRET
# PAYMONGO_TEST_PAYMENT_METHOD_TYPES=qrph
# PAYMONGO_LIVE_SECRET_KEY=sk_live_REPLACE_ME
# PAYMONGO_LIVE_WEBHOOK_SECRET=REPLACE_LIVE_WEBHOOK_SECRET
# PAYMONGO_LIVE_PAYMENT_METHOD_TYPES=qrph
# PAYMONGO_SYSTEM_ACTOR_USER_ID=1
# PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
# PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancelled

# Production Railway PayMongo QR Ph example:
# NODE_ENV=production
# PAYMONGO_ENABLED=true
# PAYMONGO_MODE=live
# PAYMONGO_ALLOW_LIVE_LOCAL=false
# PAYMONGO_TEST_SECRET_KEY=
# PAYMONGO_TEST_WEBHOOK_SECRET=
# PAYMONGO_TEST_PAYMENT_METHOD_TYPES=qrph
# PAYMONGO_LIVE_SECRET_KEY=sk_live_REPLACE_ME
# PAYMONGO_LIVE_WEBHOOK_SECRET=REPLACE_LIVE_WEBHOOK_SECRET
# PAYMONGO_LIVE_PAYMENT_METHOD_TYPES=qrph
# PAYMONGO_SYSTEM_ACTOR_USER_ID=1
# PAYMENT_SUCCESS_URL=https://nffac.trackcoop.online/payment/success
# PAYMENT_CANCEL_URL=https://nffac.trackcoop.online/payment/cancelled
