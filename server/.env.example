NODE_ENV=development
API_PORT=5000
FRONTEND_URL=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trackcoop
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA_PATH=
DB_CONNECTION_LIMIT=10

SESSION_COOKIE_NAME=trackcoop_session
SESSION_TTL_HOURS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
UPLOAD_DIR=storage/uploads

PAYMONGO_ENABLED=true
PAYMONGO_MODE=test
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=replace_with_paymongo_test_secret_key
PAYMONGO_WEBHOOK_SECRET=replace_with_paymongo_webhook_secret
PAYMONGO_SYSTEM_ACTOR_USER_ID=1000
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMONGO_CHECKOUT_REUSE_MINUTES=30
PAYMONGO_PAYMENT_METHOD_TYPES=card
PAYMONGO_PASS_ON_FEES=false
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancelled
