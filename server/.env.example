# Express API host (server/.env)
# Keep API-only secrets here, not in frontend NEXT_PUBLIC_* variables.
NODE_ENV=development
API_PORT=5000
PORT=
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trackcoop
DB_USER=root
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA_PATH=
DB_CONNECTION_LIMIT=10

SESSION_COOKIE_NAME=trackcoop_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_MINUTES=15
BCRYPT_ROUNDS=12

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=storage/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=

PAYMONGO_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_API_BASE_URL=https://api.paymongo.com
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SYSTEM_ACTOR_USER_ID=
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
PAYMONGO_CHECKOUT_REUSE_MINUTES=30
PAYMONGO_PAYMENT_METHOD_TYPES=card
PAYMONGO_PASS_ON_FEES=false
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancelled

# Optional: POST rental booking-summary and status email payloads to a mail provider or automation webhook.
RENTAL_STATUS_EMAIL_WEBHOOK_URL=
RENTAL_STATUS_EMAIL_WEBHOOK_TOKEN=

# Generic production example, provider-neutral:
# NODE_ENV=production
# FRONTEND_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SESSION_COOKIE_DOMAIN=.example.com
# SESSION_COOKIE_SAME_SITE=lax
# SESSION_COOKIE_SECURE=true
# TRUST_PROXY=true
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_LOGIN_RATE_WINDOW_MINUTES=15
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://object-storage.example.com
# S3_REGION=auto
# S3_BUCKET=trackcoop-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
